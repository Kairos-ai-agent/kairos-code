# LLM API Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
DEEPSEEK_API_KEY=your-deepseek-key
DASHSCOPE_API_KEY=your-dashscope-key
ZHIPUAI_API_KEY=your-zhipuai-key
GEMINI_API_KEY=your-gemini-key

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-key

# Application
# SECURITY: keep the API on loopback unless you really need LAN access.
# If you bind a non-loopback host, you MUST set KAIROS_API_TOKEN too.
KAIROS_HOST=127.0.0.1
KAIROS_PORT=8900
KAIROS_DEBUG=false

# Optional API token. When set, every /api route (except /api/health, /docs,
# /openapi.json, /redoc) requires Authorization: Bearer <token>, X-API-Token,
# or ?token=. The /ws socket is exempt so the bundled UI still connects.
#KAIROS_API_TOKEN=

# Optional filesystem browse allow-roots for /api/fs/* (comma-separated
# absolute paths). Default: workspace_dir + home. Set to "*" to allow the
# historical whole-drive browsing.
#KAIROS_FS_ALLOW_ROOTS=*

# Build/test toolchain (npm / pnpm / yarn / go / cargo / rustc / make / cmake)
# is DISABLED by default in the terminal tool because these run arbitrary code
# through project config. Set to 1 only if the agent's Coder/Reviewer actually
# needs to run the project's build/test command. (Read/query commands like
# ls / grep / git status / pytest stay enabled regardless.)
#KAIROS_ENABLE_BUILD_COMMANDS=1
