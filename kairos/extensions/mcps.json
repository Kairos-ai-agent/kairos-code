        "--repository",
        "."
      ],
      "description": "git log/diff/show/status/branch/blame via MCP.",
      "source": "https://github.com/modelcontextprotocol/servers",
      "stars": "8.5k",
      "official": true,
      "bundled": true,
      "needsNetwork": false
    },
