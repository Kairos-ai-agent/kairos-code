# Editor conventions for Kairos Code.
# The root cause of most line-ending churn in this repo: Windows editors writing
# CRLF into files that were committed with LF (or vice versa).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{bat,vbs}]
end_of_line = crlf
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{json,jsonl}]
indent_size = 2
