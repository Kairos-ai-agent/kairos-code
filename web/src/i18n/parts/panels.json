  "agentsMd.editTitle": {
    "zh": "编辑 AGENTS.md（项目记忆 —— 注入到每个 agent 的系统提示词）",
    "en": "Edit AGENTS.md (project memory — injected into every agent's system prompt)"
  },
  "agentsMd.header": {
    "zh": "项目记忆（AGENTS.md）",
    "en": "Project Memory (AGENTS.md)"
  },
  "agentsMd.description": {
    "zh": "每个 agent（Coder、Reviewer、security、perf、test、docs、design、refactor）都会读取该文件，并把它前置到系统提示词中。可以用它记录约定、工具选型和需要跨会话记住的反馈。项目级覆盖全局级，两者都覆盖内置默认值。每个作用域上限 4 KB。",
    "en": "This file is read by every agent (Coder, Reviewer, security, perf, test, docs, design, refactor) and prepended to the agent's system prompt. Use it to record conventions, tooling choices, or recurring feedback that the agent should remember across sessions. Project overrides global, both override built-in fallback. 4 KB cap per scope."
  },
