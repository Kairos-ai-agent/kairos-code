# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
*.egg

# Node
web/node_modules/
web/dist/

# Data
workspace/
data/
*.db

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Secrets
# Anchored to the repo root on purpose: an unanchored `settings.json` also
# matched web/src/i18n/parts/settings.json (a source-of-truth i18n fragment),
# which silently kept 298 translation keys out of the repository — every clean
# clone then failed `merge_i18n.py --strict` with "stale" keys.
/settings.json
/data/settings.json

# --- repo hygiene: scratch, build output and unrelated tool state ---
_dsh_extract/
_dsh_pkg/
build/
.loop_tmp/
.agn_tmp/
.merkle-snapshot.json
.kairos/
logs/
_api_test_workspace/
project1/
123/
.codeartsdoer/

# --- tool caches ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- frontend build output ---
web/dist/
web/node_modules/

# --- never again: third-party packages / archives the loop's auto-commit swept in ---
# An early Kairos loop ran with the repo root as its work_dir and its checkpoint
# commit picked up a 640 MB Codex archive (_codex56.rar) plus an extracted
# third-party product dump (_leila_extract/). Both are gone from history now;
# these rules keep them (and anything like them) out.
_*_extract/
_leila_extract/
_extract_*.py
_extract_*.mjs
_check_extract.py
*.rar
*.7z
*.iso

# Local build outputs (numbered/release dirs exist because a running dist/ exe locks its file)
/dist*/
# Git worktrees the loop creates for the Coder/Reviewer during a run
/.kairos-worktrees/
