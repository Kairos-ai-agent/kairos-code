{
  "version": 2,
  "comment": "R38.11: entries flagged \"bundled\": true are served locally by kairos.mcp_local_servers / kairos.mcp_filesystem_server -- no npx, no uvx, no download. The rest still need the network at first use.",
  "servers": [
    {
      "name": "filesystem",
      "category": "core",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "--root",
        "."
      ],
      "description": "Read/write/list files under a configured root. The workhorse MCP for any coding agent.",
